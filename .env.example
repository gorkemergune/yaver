# Copy to .env and fill in. .env is never committed.

# --- App ---
APP_NAME=Yaver
APP_USER_NAME=Görkem
APP_TIMEZONE=Europe/Istanbul
APP_LANGUAGE=tr
# Login for the web and desktop apps. Empty = no login (only OK while Yaver is reachable
# from this computer alone). Set one before opening it to your phone (Tailscale).
APP_PASSWORD=
# A login lasts this many days after its last use.
SESSION_DAYS=30

# --- Docker ports (host side) ---
WEB_PORT=8080
# dev only (docker-compose.override.yml), bound to 127.0.0.1
API_PORT=8000
DB_PORT=5432

# --- Database ---
POSTGRES_USER=yaver
POSTGRES_PASSWORD=change-me
POSTGRES_DB=yaver
# Only used when running the backend outside Docker (e.g. `uv run uvicorn ...`).
# Use 127.0.0.1, not localhost: on Windows localhost tries ::1 first (WSL relay) and is slow.
# docker compose builds its own URL from the POSTGRES_* values above (host: db).
DATABASE_URL=postgresql+asyncpg://yaver:change-me@127.0.0.1:5432/yaver

# --- LLM providers (BYOK) ---
# Free tier, default "fast" tier: https://console.groq.com
GROQ_API_KEY=
# Optional "fallback" / "smart" tiers: https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- Budget guard ---
# Monthly Claude spend limit. >= 80%: smart tier falls back to Haiku; >= 100%: only Groq/Ollama.
CLAUDE_MONTHLY_BUDGET_USD=4

# --- Clock convention: how a bare hour is read ("9'da" -> 09:00, "3'te" -> 15:00) ---
# Hours outside both ranges, and ranges like "7-9", are asked back to the user.
CLOCK_MORNING_HOURS=8-11
CLOCK_AFTERNOON_HOURS=1-7

# --- LLM ---
# Groq free tier answers 429 with "try again in Ns": sit out waits up to this many seconds
# (the chat shows "Groq yoğun..."), longer ones fail over to Claude Haiku.
GROQ_MAX_RETRY_WAIT_SEC=8
# Check that the models in config/providers.yaml exist when the API starts (logs only).
LLM_CHECK_MODELS_ON_STARTUP=true

# --- Backups (pg_dump .sql.gz; scripts/backup.ps1 / backup.sh take and restore them) ---
# Folder on this computer (mounted into the api container as /backups). Default: ./backups
BACKUP_DIR=./backups
BACKUP_KEEP=14
# The api backs up on startup when the newest backup is older than this.
BACKUP_MAX_AGE_HOURS=24
BACKUP_ON_STARTUP=true

# --- Scheduler (local times in APP_TIMEZONE) ---
# Morning briefing, evening check-in and follow-up questions are written into the chat.
SCHEDULER_ENABLED=true
BRIEFING_TIME=08:00
CHECKIN_TIME=21:00
FOLLOWUP_TIME=12:00
# Sundays: a draft of the coming week (smart tier), written into tasks after "evet".
WEEKLY_PLAN_TIME=20:00
# Daily: a review plan for exams about a week away (tasks after "evet").
EXAM_PREP_TIME=18:00

# --- Web Push (Phase 1) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
