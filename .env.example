# Copy to .env and fill in. .env is never committed.

# --- App ---
APP_NAME=Yaver
APP_USER_NAME=Görkem
APP_TIMEZONE=Europe/Istanbul
APP_LANGUAGE=tr
# Login for the web and desktop apps. Empty = no login (only OK while Yaver is reachable
# from this computer alone). Set one before opening it to your phone (Tailscale).
APP_PASSWORD=
# A login lasts this many days after its last use.
SESSION_DAYS=30
# Proxies allowed to say who the client is (X-Forwarded-For): addresses / networks, comma
# separated. Default: this machine and Docker's networks (nginx in the web container).
TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12

# --- Docker ports (host side) --- docs/tr/canli-ve-gelistirme.md
# LIVE stack (project yaver-live, the real data; scripts/deploy-live.ps1 updates it)
LIVE_WEB_PORT=8080
# DEVELOPMENT stack (project yaver-dev, `docker compose up`; own database), all on 127.0.0.1
DEV_WEB_PORT=8180
DEV_API_PORT=8100
DEV_DB_PORT=5532
# true = the dev stack also runs the briefing / check-in / shift jobs (LLM spend from dev too)
DEV_SCHEDULER_ENABLED=false
# Where scripts/deploy-live.ps1 keeps releases, logs and state (default %USERPROFILE%\yaver-releases)
# YAVER_RELEASES=

# --- Database ---
POSTGRES_USER=yaver
POSTGRES_PASSWORD=change-me
POSTGRES_DB=yaver
# Only used when running the backend outside Docker (e.g. `uv run uvicorn ...`): the DEV
# database (DEV_DB_PORT). The live database has no host port.
# Use 127.0.0.1, not localhost: on Windows localhost tries ::1 first (WSL relay) and is slow.
# docker compose builds its own URL from the POSTGRES_* values above (host: db).
DATABASE_URL=postgresql+asyncpg://yaver:change-me@127.0.0.1:5532/yaver

# --- LLM providers (BYOK) ---
# Free tier, default "fast" tier: https://console.groq.com
GROQ_API_KEY=
# Optional "fallback" / "smart" tiers: https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- Budget guard ---
# Monthly Claude spend limit. >= 80%: smart tier falls back to Haiku; >= 100%: only Groq/Ollama.
CLAUDE_MONTHLY_BUDGET_USD=4
# "deep" tier (Claude Opus 5.5): only the weekly jobs marked deep in providers.yaml (weekly ad
# report, weekly startup review). Own monthly limit, inside the Claude budget above; once it
# is reached those jobs run on "smart" (Sonnet). 0 = never use Opus.
DEEP_MONTHLY_BUDGET_USD=2

# --- Clock convention: how a bare hour is read ("9'da" -> 09:00, "3'te" -> 15:00) ---
# Hours outside both ranges, and ranges like "7-9", are asked back to the user.
CLOCK_MORNING_HOURS=8-11
CLOCK_AFTERNOON_HOURS=1-7

# --- LLM ---
# Groq free tier answers 429 with "try again in Ns": sit out waits up to this many seconds
# (the chat shows "Groq yoğun..."), longer ones fail over to Claude Haiku.
GROQ_MAX_RETRY_WAIT_SEC=8
# A chat answer taking longer than this ends with "Cevap gelmedi (zaman aşımı)" and saves
# nothing; meanwhile the stream sends a ping every 15 s so proxies don't cut it.
CHAT_TIMEOUT_SECONDS=240
# Check that the models in config/providers.yaml exist when the API starts (logs only).
LLM_CHECK_MODELS_ON_STARTUP=true

# --- Backups (pg_dump .sql.gz; scripts/backup.ps1 / backup.sh take and restore them) ---
# Folder on this computer (mounted into the api container as /backups). Default: ./backups
BACKUP_DIR=./backups
BACKUP_KEEP=14
# The api backs up on startup when the newest backup is older than this.
BACKUP_MAX_AGE_HOURS=24
BACKUP_ON_STARTUP=true

# --- Scheduler (local times in APP_TIMEZONE) ---
# Morning briefing, evening check-in and follow-up questions are written into the chat.
SCHEDULER_ENABLED=true
# With the office the briefing starts with the standup: everyone meets, each says 1-2 sentences.
BRIEFING_TIME=09:00
CHECKIN_TIME=21:00
FOLLOWUP_TIME=12:00
# Sundays: a draft of the coming week (smart tier), written into tasks after "evet".
WEEKLY_PLAN_TIME=20:00
# Daily: a review plan for exams about a week away (tasks after "evet").
EXAM_PREP_TIME=18:00
# Yaver's day report from the employees' notebooks and inboxes (after the check-in).
DAY_REPORT_TIME=21:15

# --- Integrations (office employees) ---
# Web search for Mentor / Venture / Creator. One key is enough; without one they note
# "web arama anahtarı bekleniyor" in their notebook. auto = the first provider with a key.
WEB_SEARCH_PROVIDER=auto
# https://tavily.com (free tier: 1000 searches / month)
TAVILY_API_KEY=
# https://brave.com/search/api (free tier)
BRAVE_API_KEY=
# Metrics (ads analyst): Meta Marketing API. Not wired up yet; ad reports come from files
# (an Ads Manager CSV or a screenshot sent in the chat).
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
# Venture (startup): the startup's GitHub repository, READ ONLY. Fine-grained token
# (github.com -> Settings -> Developer settings -> Fine-grained tokens), only this repo,
# permissions "Contents", "Issues", "Pull requests", "Metadata": Read-only.
# Without both, Venture notes "GitHub entegrasyonu bekliyor".
GITHUB_TOKEN=
# owner/name, e.g. acme/startup (a pasted github.com URL works too)
GITHUB_STARTUP_REPO=

# --- Web Push (Phase 1) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
